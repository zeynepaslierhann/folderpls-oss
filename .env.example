# FolderPls environment variables.
# Copy this file to .env.local and fill in your own values. Never commit real values.
# Setup steps for each value are in README.md, under "Run your own instance".

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# OAuth 2.0 Web application client ID. No client secret is used.
NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=

# API key restricted to the Google Picker API.
NEXT_PUBLIC_GOOGLE_API_KEY=

# Numeric project number of your Google Cloud project (not the project ID).
NEXT_PUBLIC_GOOGLE_CLOUD_PROJECT_NUMBER=

# Origin of this instance, without a trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Hosting provider named in the privacy policy (company name, e.g. "Example
# Hosting Inc.") and, optionally, where its servers run (e.g. "Frankfurt").
# Read at build time. If unset, the policy shows a visible placeholder.
# HOSTING_PROVIDER=
# HOSTING_REGION=

# Contact address shown on the site. When unset, the site points to GitHub issues.
# NEXT_PUBLIC_CONTACT_EMAIL=

# The Content-Security-Policy (per-request nonce, set in proxy.ts) is enforced
# by default. Set to 1 in the server's environment to send it as Report-Only
# instead: violations are reported to /api/csp-report but not blocked. Use it
# only as a temporary escape hatch, for example while adding a third party.
# CSP_REPORT_ONLY=1

# Error reporting is off unless a DSN is set. Nothing is sent without it.
# NEXT_PUBLIC_SENTRY_DSN=

# Only needed to upload source maps at build time. SENTRY_URL defaults to
# Sentry's EU region. SENTRY_ORG and SENTRY_PROJECT are read by Sentry's build
# plugin.
# SENTRY_AUTH_TOKEN=
# SENTRY_URL=
# SENTRY_ORG=
# SENTRY_PROJECT=
